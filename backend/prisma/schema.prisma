datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id               String         @id @default(uuid())
  email            String         @unique
  password         String?
  firstName        String?
  lastName         String?
  avatarUrl        String?
  role             String         @default("PARTICIPANT") // PARTICIPANT, ADMIN, SUPER_ADMIN
  emailVerified    Boolean        @default(false)
  verificationCode String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  refreshTokens    RefreshToken[]
  registrations    Registration[]
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Hackathon {
  id                 String    @id @default(uuid())
  name               String
  tagline            String?
  description        String
  registrationStart  DateTime?
  registrationClose  DateTime?
  eventStart         DateTime?
  eventClose         DateTime?
  bannerUrl          String?
  submissionEnabled  Boolean   @default(false)
  leaderboardEnabled Boolean   @default(false)
  discussionEnabled  Boolean   @default(false)
  problemReleased    Boolean   @default(false)
  rounds             Json
  problemTitle       String?
  problemDescription String?
  testCases          Json
  rules              Json
  resources          Json
  status             String    @default("upcoming") // derived lifecycle cache: draft, upcoming, active, completed, archived
  published          Boolean   @default(false)
  archived           Boolean   @default(false)
  publishedAt        DateTime?
  startDate          DateTime?
  endDate            DateTime?
  createdAt          DateTime  @default(now())
}

model Blueprint {
  id                     String   @id @default(uuid())
  hackathonId            String   @unique
  problemStatement       Json
  problemStatements      Json?
  requiredFeatures       Json
  techStackRules         Json
  submissionRequirements Json
  codeQualityRules       Json
  performanceRules       Json
  securityRules          Json
  scoringSystem          Json
  autoPassFailRules      Json
  bonusRules             Json
  status                 String   @default("draft") // draft | published
  version                Int      @default(1)
  publishedAt            DateTime?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @default(now())
}

// Immutable snapshot of every published blueprint version so historical
// evaluations remain reproducible even after the current blueprint is edited.
model BlueprintVersion {
  id          String   @id @default(uuid())
  blueprintId String
  hackathonId String
  version     Int
  payload     Json
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([hackathonId])
  @@index([blueprintId])
}

model Submission {
  id                  String             @id @default(uuid())
  hackathonId         String
  problemStatementId  String?
  userId              String
  repoUrl             String
  deploymentUrl       String?
  projectName         String             @default("Untitled Project")
  shortDesc           String             @default("")
  detailedDesc        String             @default("")
  problemSolved       String             @default("")
  features            Json               // Array of dynamic tags
  techStack           Json               // Object mapping layers to lists
  videoUrl            String?
  presentationPdf     String?
  architectureDiagram String?
  teamContributions   Json               // Array of roles
  version             Int                @default(1)
  status              String             @default("PENDING") // PENDING, QUEUED, CLONING, etc.
  score               Int?
  grade               String?
  bestScore           Int?               // Highest score achieved across all evaluation attempts
  latestAttemptId     String?            // Reference to the most recent EvaluationAttempt
  blueprintId         String?            // blueprint used for this evaluation (immutable binding)
  blueprintVersion    Int?               // blueprint version used for this evaluation
  completedAt         DateTime?          // set when evaluation completes (leaderboard tie-break)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  reports             EvaluationReport[]
  attempts            EvaluationAttempt[]

  @@index([hackathonId])
  @@index([userId])
  @@index([status])
  @@index([hackathonId, userId])
  @@index([hackathonId, status])
}

model EvaluationAttempt {
  id               String     @id @default(uuid())
  submissionId     String
  submission       Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  attemptNumber    Int
  commitSha        String?
  repoUrl          String
  deploymentUrl    String?
  blueprintId      String
  blueprintVersion Int
  status           String     @default("QUEUED")
  score            Int?
  grade            String?
  reportPayload    Json?
  completedAt      DateTime?
  createdAt        DateTime   @default(now())

  @@index([submissionId])
  @@index([submissionId, attemptNumber])
}

model EvaluationReport {
  id           String     @id @default(uuid())
  submissionId String     @unique
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  payload      Json
  createdAt    DateTime   @default(now())
}

model Registration {
  id                String   @id @default(uuid())
  hackathonId       String
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  collegeName       String?
  teamName          String?
  participationMode String   @default("solo")
  status            String   @default("PENDING") // PENDING, SHORTLISTED, REJECTED, APPROVED
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([hackathonId, userId])
}

model SystemConfig {
  id                     String   @id @default("global")
  allowRegistration      Boolean  @default(true)
  enableAstEvaluation    Boolean  @default(true)
  maintenanceMode        Boolean  @default(false)
  forceEmailVerification Boolean  @default(false)
  updatedAt              DateTime @updatedAt
}

model QrVerification {
  id        String   @id @default(uuid())
  uniqueId  String   @unique
  name      String
  status    String   @default("ACTIVE") // ACTIVE, REVOKED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([uniqueId])
}

model CertificateTemplate {
  id           String        @id @default(uuid())
  title        String
  description  String?
  layout       Json          // Canvas size, background, frame, elements (positions, text, fonts, colors, logo/signature data URLs)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  certificates Certificate[]
}

model Certificate {
  id              String               @id @default(uuid())
  uniqueId        String               @unique
  participantName String
  eventName       String?
  issueDate       String?
  status          String               @default("ACTIVE") // ACTIVE, REVOKED
  templateId      String?
  template        CertificateTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  snapshotLayout  Json?                // Frozen snapshot of layout at issuance time
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([uniqueId])
  @@index([templateId])
}


